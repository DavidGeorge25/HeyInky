    "insertChemScheme": {
      "type": "object",
      "description": "A clean, typeset chemistry figure the app draws with RDKit (exact structures, aligned layouts): resonance structures, reactions, equilibria, mechanisms with curved arrows. Use for NEW structures that aren't on the page yet. Atoms you want to point at must carry atom-map numbers in the SMILES, e.g. \"C[C:2](=[O:1])[O-:3]\"; refer to them by number.",
      "additionalProperties": false,
      "required": [
        "type",
        "near",
        "title",
        "steps",
        "connectors",
        "arrows",
        "lonePairs",
        "highlights",
        "caption"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "insertChemScheme"
          ]
        },
        "near": {
          "$ref": "#/$defs/region"
        },
        "title": {
          "type": [
            "string",
            "null"
          ],
          "description": "Short title above the figure, or null."
        },
        "steps": {
          "type": "array",
          "description": "Structures left to right. Write Kekulé SMILES (explicit = bonds, uppercase atoms) for resonance forms so each form shows its own double bonds; charges in brackets ([O-], [N+], [CH2+]).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "smiles",
              "label"
            ],
            "properties": {
              "smiles": {
                "type": "string"
              },
              "label": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Short caption under this structure, or null."
              }
            }
          }
        },
        "connectors": {
          "type": "array",
          "description": "Exactly one per gap between consecutive steps.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "above",
              "below"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "resonance",
                  "reaction",
                  "equilibrium",
                  "plus",
                  "none"
                ]
              },
              "above": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Reagent/condition text above the arrow, or null."
              },
              "below": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "arrows": {
          "type": "array",
          "description": "Curved electron-pushing arrows inside one step (0-based step index). from: map number of an atom (its lone pair) or bond \"1-2\"; to: atom \"2\" or bond/new bond \"2-3\".",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "from",
              "to",
              "kind"
            ],
            "properties": {
              "step": {
                "type": "integer"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "curved",
                  "fishhook"
                ],
                "description": "curved = electron-pair arrow (full head); fishhook = single-electron arrow (half head)."
              }
            }
          }
        },
        "lonePairs": {
          "type": "array",
          "description": "Lone pairs to show as dot pairs (atom map numbers).",
          "items": {
            "type": "object",
            "additionalProperties": false,
