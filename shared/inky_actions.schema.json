        },
        "caption": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "insertMath": {
      "type": "object",
      "description": "Beautifully typeset math (TeX, rendered by the app): formulas, worked solutions and derivations as aligned steps, chemical equations with \\\\ce{}. Use when the student wants it written neatly, for formulas they should copy, and for multi-step working where typesetting reads better than handwriting.",
