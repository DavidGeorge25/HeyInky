    0.1622,
    0.643,
    0.017
   ]
  },
  {
   "text": "Equilibrium constant:  K = [C]^c [D]^d / [A]^a [B]^b",
   "box": [
    0.0882,
    0.221,
    0.5114,
    0.017
   ]
  },
  {
